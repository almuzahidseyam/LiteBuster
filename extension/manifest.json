{
  "manifest_version": 3,
  "name": "LiteBuster Demo (Pro)",
  "version": "2.0",
  "description": "On-Device Audio CAPTCHA Recognition using ONNX WebGPU and Chrome Side Panel",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LiteBuster Panel"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://127.0.0.1/*", "*://localhost/*"],
      "js": ["content/content.js"]
    }
  ]
}
